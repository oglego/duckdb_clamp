# name: test/sql/clamp.test
# description: test clamp extension
# group: [sql]

# Require statement will ensure this test is run with this extension loaded
require clamp

# ------------------------------------------------------------------------------
# CLAMP TESTS
# ------------------------------------------------------------------------------

# Confirm the extension works
query I
SELECT clamp(15, 10, 20);
----
15

# Test: value below minimum
query I
SELECT clamp(5, 10, 20);
----
10

# Test: value above maximum
query I
SELECT clamp(25, 10, 20);
----
20

# Test: value equal to minimum
query I
SELECT clamp(10, 10, 20);
----
10

# Test: value equal to maximum
query I
SELECT clamp(20, 10, 20);
----
20

# Test: minimum equals maximum
query I
SELECT clamp(15, 10, 10);
----
10

# Test: negative numbers
query I
SELECT clamp(-5, -10, 0);
----
-5

# Test: value below negative minimum
query I
SELECT clamp(-15, -10, 0);
----
-10

# Test: value above zero maximum
query I
SELECT clamp(5, -10, 0);
----
0

# Test: floating point values
query I
SELECT clamp(3.14, 2.71, 4.0);
----
3.14

# Test: floating point below minimum
query I
SELECT clamp(2.0, 2.71, 4.0);
----
2.71

# Test: floating point above maximum
query I
SELECT clamp(5.0, 2.71, 4.0);
----
4.0

# Test: NULL input returns NULL
query I
SELECT clamp(NULL, 10, 20);
----
NULL

query I
SELECT clamp(15, NULL, 20);
----
NULL

query I
SELECT clamp(15, 10, NULL);
----
NULL

# Test: NaN propagation
query I
SELECT clamp(CAST('NaN' AS DOUBLE), 10, 20);
----
NaN

query I
SELECT clamp(15, CAST('NaN' AS DOUBLE), 20);
----
NaN

query I
SELECT clamp(15, 10, CAST('NaN' AS DOUBLE));
----
NaN

# Test: minimum greater than maximum (should throw error)
statement error
SELECT clamp(15, 20, 10);
----
Error: Minimum bound (20) cannot be greater than maximum bound (10).

# ------------------------------------------------------------------------------
# CLIP TESTS
# ------------------------------------------------------------------------------

# Confirm the extension works
query I
SELECT clip(15, 10, 20);
----
15

# Test: value below minimum
query I
SELECT clip(5, 10, 20);
----
10

# Test: value above maximum
query I
SELECT clip(25, 10, 20);
----
20

# Test: value equal to minimum
query I
SELECT clip(10, 10, 20);
----
10

# Test: value equal to maximum
query I
SELECT clip(20, 10, 20);
----
20

# Test: minimum equals maximum
query I
SELECT clip(15, 10, 10);
----
10

# Test: negative numbers
query I
SELECT clip(-5, -10, 0);
----
-5

# Test: value below negative minimum
query I
SELECT clip(-15, -10, 0);
----
-10

# Test: value above zero maximum
query I
SELECT clip(5, -10, 0);
----
0

# Test: floating point values
query I
SELECT clip(3.14, 2.71, 4.0);
----
3.14

# Test: floating point below minimum
query I
SELECT clip(2.0, 2.71, 4.0);
----
2.71

# Test: floating point above maximum
query I
SELECT clip(5.0, 2.71, 4.0);
----
4.0

# Test: NULL input returns NULL
query I
SELECT clip(NULL, 10, 20);
----
NULL

query I
SELECT clip(15, NULL, 20);
----
NULL

query I
SELECT clip(15, 10, NULL);
----
NULL

# Test: NaN propagation
query I
SELECT clip(CAST('NaN' AS DOUBLE), 10, 20);
----
NaN

query I
SELECT clip(15, CAST('NaN' AS DOUBLE), 20);
----
NaN

query I
SELECT clip(15, 10, CAST('NaN' AS DOUBLE));
----
NaN

# Test: minimum greater than maximum (should throw error)
statement error
SELECT clip(15, 20, 10);
----
Error: Minimum bound (20) cannot be greater than maximum bound (10).

# ------------------------------------------------------------------------------
# SATURATE TESTS (clamp to [0.0, 1.0])
# ------------------------------------------------------------------------------

# Test: value inside range
query I
SELECT saturate(0.5);
----
0.5

# Test: value below 0
query I
SELECT saturate(-0.25);
----
0.0

# Test: value above 1
query I
SELECT saturate(1.75);
----
1.0

# Test: value equal to 0
query I
SELECT saturate(0.0);
----
0.0

# Test: value equal to 1
query I
SELECT saturate(1.0);
----
1.0

# Test: NULL input returns NULL
query I
SELECT saturate(NULL);
----
NULL

# ------------------------------------------------------------------------------
# CLAMP01 TESTS (alias of saturate)
# ------------------------------------------------------------------------------

# Test: value inside range
query I
SELECT clamp01(0.25);
----
0.25

# Test: value below 0
query I
SELECT clamp01(-1.0);
----
0.0

# Test: value above 1
query I
SELECT clamp01(2.0);
----
1.0

# Test: boundary values
query II
SELECT clamp01(0.0), clamp01(1.0);
----
0.0	1.0

# Test: NULL input returns NULL
query I
SELECT clamp01(NULL);
----
NULL

# ------------------------------------------------------------------------------
# WRAP TESTS
# ------------------------------------------------------------------------------

# Test: Inside range (no change)
query I
SELECT wrap(15, 10, 20);
----
15

# Test: Exact boundary (min returns min, max wraps to min)
query II
SELECT wrap(10, 10, 20), wrap(20, 10, 20);
----
10	10

# Test: Wrapping forward (one full period)
query I
SELECT wrap(25, 10, 20);
----
15

# Test: Wrapping forward (multiple periods)
query I
SELECT wrap(45, 10, 20);
----
15

# Test: Wrapping backward (negative offset)
query I
SELECT wrap(5, 10, 20);
----
15

# Test: Wrapping backward (multiple periods)
query I
SELECT wrap(-15, 10, 20);
----
15

# Test: 360-degree wrapping (Angles)
query III
SELECT wrap(370, 0, 360), wrap(-10, 0, 360), wrap(720, 0, 360);
----
10.0	350.0	0.0

# Test: Negative range wrapping
query I
SELECT wrap(-11, -10, -5);
----
-6

# Test: NULL handling (should return NULL if any arg is NULL)
query III
SELECT wrap(NULL, 10, 20), wrap(15, NULL, 20), wrap(15, 10, NULL);
----
NULL	NULL	NULL

# Test: NaN propagation
query I
SELECT wrap(CAST('NaN' AS DOUBLE), 0, 10);
----
NaN

# Test: Minimum >= Maximum (should throw error)
statement error
SELECT wrap(15, 20, 10);
----
Error: Minimum bound (20) cannot be greater than or equal to maximum bound (10).

# Test: Minimum equals Maximum (should throw error)
statement error
SELECT wrap(15, 10, 10);
----
Error: Minimum bound (10) cannot be greater than or equal to maximum bound (10).

# Test: Precision edge case
query I
SELECT wrap(19.99999999999999, 10, 20);
----
19.99999999999999

# ------------------------------------------------------------------------------
# PINGPONG TESTS
# ------------------------------------------------------------------------------
query I
SELECT pingpong(12, 0, 10);
----
8.0

# Test: Inside range ascending
query I
SELECT pingpong(13, 10, 20);
----
13.0

# Test: Exact boundaries
query II
SELECT pingpong(10, 10, 20), pingpong(20, 10, 20);
----
10.0	20.0

# Test: Bouncing back (descending)
# 22 is 2 past the max (20), so it should be 20 - 2 = 18
query I
SELECT pingpong(22, 10, 20);
----
18.0

# Test: Multiple periods (returning to start)
# 30 is a full "round trip" (10 up, 10 down) from the start
query I
SELECT pingpong(30, 10, 20);
----
10.0

# Test: Negative input (bouncing in the other direction)
# 8 is 2 below the min (10), so it should bounce up to 12
query I
SELECT pingpong(8, 10, 20);
----
12.0

# Test: Small range oscillation
query I
SELECT pingpong(1.5, 0.0, 1.0);
----
0.5

# Test: NULL handling
query III
SELECT pingpong(NULL, 0, 10), pingpong(5, NULL, 10), pingpong(5, 0, NULL);
----
NULL	NULL	NULL

# Test: NaN propagation
query I
SELECT pingpong(CAST('NaN' AS DOUBLE), 0, 10);
----
NaN

# Test: Error handling (min > max)
statement error
SELECT pingpong(5, 20, 10);
----
Error: Minimum bound (20) cannot be greater than or equal to maximum bound (10).

# Test BIGINT
query I
SELECT pingpong(13::BIGINT, 10::BIGINT, 20::BIGINT);
----
13

# Test: Large BIGINT values
query I
SELECT pingpong(9223372036854775800, 0, 9223372036854775806);
----
9223372036854775800

# Test: Pingpong zero range (should error)
statement error
SELECT pingpong(15, 10, 10);
----
Error: Minimum bound (10) cannot be greater than or equal to maximum bound (10).

# Misc Test
query I
SELECT pingpong(12, 10, 20);
----
12.0

# Misc Test
query I
SELECT pingpong(22, 10, 20);
----
18.0

# Misc Test
query I
SELECT pingpong(28, 10, 20);
----
12.0

# ------------------------------------------------------------------------------
# FRACT TESTS
# ------------------------------------------------------------------------------

# Test: Standard positive fractional part
query I
SELECT fract(1.75);
----
0.75

# Test: Negative fractional part (should return 0.9, not -0.1)
query I
SELECT fract(-0.1);
----
0.9

# Test: Whole numbers (should return 0.0)
query II
SELECT fract(5.0), fract(-2.0);
----
0.0	0.0

# Test: Integer input (should return 0)
query I
SELECT fract(10);
----
0

# Test: NULL handling
query I
SELECT fract(NULL);
----
NULL

# Test: NaN propagation
query I
SELECT fract(CAST('NaN' AS DOUBLE));
----
NaN

# Test: Fract near integer boundaries
query II
SELECT fract(0.9999999999), fract(-0.0000000001);
----
0.9999999999	0.9999999999

# Misc Test
query I
SELECT fract(1.75);
----
0.75

# Misc Test
query I
SELECT fract(10);
----
0.0

# Misc Test
query I
SELECT fract(-0.1);
----
0.9

query I
SELECT fract(42.25);
----
0.25