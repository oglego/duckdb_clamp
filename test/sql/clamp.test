# name: test/sql/clamp.test
# description: test clamp extension
# group: [sql]

# Require statement will ensure this test is run with this extension loaded
require clamp

# ------------------------------------------------------------------------------
# CLAMP TESTS
# ------------------------------------------------------------------------------

# Confirm the extension works
query I
SELECT clamp(15, 10, 20);
----
15

# Test: value below minimum
query I
SELECT clamp(5, 10, 20);
----
10

# Test: value above maximum
query I
SELECT clamp(25, 10, 20);
----
20

# Test: value equal to minimum
query I
SELECT clamp(10, 10, 20);
----
10

# Test: value equal to maximum
query I
SELECT clamp(20, 10, 20);
----
20

# Test: minimum equals maximum
query I
SELECT clamp(15, 10, 10);
----
10

# Test: negative numbers
query I
SELECT clamp(-5, -10, 0);
----
-5

# Test: value below negative minimum
query I
SELECT clamp(-15, -10, 0);
----
-10

# Test: value above zero maximum
query I
SELECT clamp(5, -10, 0);
----
0

# Test: floating point values
query I
SELECT clamp(3.14, 2.71, 4.0);
----
3.14

# Test: floating point below minimum
query I
SELECT clamp(2.0, 2.71, 4.0);
----
2.71

# Test: floating point above maximum
query I
SELECT clamp(5.0, 2.71, 4.0);
----
4.0

# Test: NULL input returns NULL
query I
SELECT clamp(NULL, 10, 20);
----
NULL

query I
SELECT clamp(15, NULL, 20);
----
NULL

query I
SELECT clamp(15, 10, NULL);
----
NULL

# Test: minimum greater than maximum (should throw error)
statement error
SELECT clamp(15, 20, 10);
----
CLAMP error: Minimum bound (20) cannot be greater than maximum bound (10).

# ------------------------------------------------------------------------------
# SATURATE TESTS (clamp to [0.0, 1.0])
# ------------------------------------------------------------------------------

# Test: value inside range
query I
SELECT saturate(0.5);
----
0.5

# Test: value below 0
query I
SELECT saturate(-0.25);
----
0.0

# Test: value above 1
query I
SELECT saturate(1.75);
----
1.0

# Test: value equal to 0
query I
SELECT saturate(0.0);
----
0.0

# Test: value equal to 1
query I
SELECT saturate(1.0);
----
1.0

# Test: NULL input returns NULL
query I
SELECT saturate(NULL);
----
NULL

# ------------------------------------------------------------------------------
# CLAMP01 TESTS (alias of saturate)
# ------------------------------------------------------------------------------

# Test: value inside range
query I
SELECT clamp01(0.25);
----
0.25

# Test: value below 0
query I
SELECT clamp01(-1.0);
----
0.0

# Test: value above 1
query I
SELECT clamp01(2.0);
----
1.0

# Test: boundary values
query II
SELECT clamp01(0.0), clamp01(1.0);
----
0.0	1.0

# Test: NULL input returns NULL
query I
SELECT clamp01(NULL);
----
NULL
